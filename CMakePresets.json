{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-platform",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/python/robosample",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "Python3_ROOT_DIR": "$env{CONDA_PREFIX}"
      }
    },
    {
      "name": "cpu",
      "hidden": true,
      "inherits": "base-platform",
      "cacheVariables": {
        "USE_CPU": "ON"
      }
    },
    {
      "name": "reference",
      "hidden": true,
      "inherits": "base-platform",
      "cacheVariables": {
        "USE_REFERENCE": "ON"
      }
    },
    {
      "name": "opencl",
      "hidden": true,
      "inherits": "base-platform",
      "cacheVariables": {
        "USE_OPENCL": "ON"
      }
    },
    {
      "name": "cuda",
      "hidden": true,
      "inherits": "base-platform",
      "cacheVariables": {
        "USE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CUDAToolkit_ROOT": "$env{CONDA_PREFIX}",
        "CMAKE_CUDA_COMPILER": "$env{CONDA_PREFIX}/bin/nvcc"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "pgo-train-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "PGO_Train"
      }
    },
    {
      "name": "pgo-use-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "PGO_Use"
      }
    },
    {
      "name": "tests-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Tests"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU: Debug",
      "inherits": [
        "cpu",
        "debug-base"
      ]
    },
    {
      "name": "cpu-release",
      "displayName": "CPU: Release",
      "inherits": [
        "cpu",
        "release-base"
      ]
    },
    {
      "name": "cpu-relwithdebinfo",
      "displayName": "CPU: RelWithDebInfo",
      "inherits": [
        "cpu",
        "relwithdebinfo-base"
      ]
    },
    {
      "name": "cpu-pgo-train",
      "displayName": "CPU: PGO Train",
      "inherits": [
        "cpu",
        "pgo-train-base"
      ]
    },
    {
      "name": "cpu-pgo-use",
      "displayName": "CPU: PGO Use",
