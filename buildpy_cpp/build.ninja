  COMMAND = cd /home/laurentiu/git6/Robosample/buildpy_cpp/pybind11 && /usr/bin/cmake --regenerate-during-build -S/home/laurentiu/git6/Robosample -B/home/laurentiu/git6/Robosample/buildpy_cpp
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build pybind11/rebuild_cache: phony pybind11/CMakeFiles/rebuild_cache.util

