{
    // Disable Microsoft C/C++ IntelliSense since we will use clangd
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.enhancedColorization": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    // Clangd configuration
    "clangd.arguments": [
        "--compile-commands-dir=build",
        "--background-index",
        "--clang-tidy"
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/python/",
        "${workspaceFolder}/python/robosample",
        "${workspaceFolder}/python/robosample/stubs",
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/python/",
        "${workspaceFolder}/python/robosample",
        "${workspaceFolder}/python/robosample/stubs",
    ],
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,

    "coverage-gutters.xmlname": "coverage.xml",
    "coverage-gutters.showLineCoverage": true,
    "coverage-gutters.showGutterCoverage": true,
    "coverage-gutters.showCustomCoverage": true,
    "coverage-gutters.manualCompile": false
}