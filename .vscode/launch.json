{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Debug Robosample Library)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/build",
                "ROBOSAMPLE_DEBUG": "1"
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "1APQ.debug",
                "data-raw/1APQ.prmtop",
                "data-raw/1APQ_min.inpcrd",
                "42",
                "10",
                "10",
                "1",
                "tdnr",
                "[]"
            ],
            "cwd": "${workspaceFolder}/build",
        },
        {
            "name": "(gdb) Attach to Python",
            "type": "cppdbg",
            "request": "attach",
            "program": "${env:CONDA_PREFIX}/bin/python",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false
        }
    ]
}
