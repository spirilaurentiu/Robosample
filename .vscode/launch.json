{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Debug Robosample Library)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/build",
                "ROBOSAMPLE_DEBUG": "1"
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "1APQ.debug",
                "data-raw/1APQ.prmtop",
                "data-raw/1APQ_min.inpcrd",
                "42",
                "10",
                "10",
                "1",
                "tdnr",
                "[]"
            ],
            "cwd": "${workspaceFolder}/build",
        },
        {
            "name": "(gdb) Attach to Python",
            "type": "cppdbg",
            "request": "attach",
            "program": "${env:CONDA_PREFIX}/bin/python",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false
        },



        {
            "name": "Python + C++ (.so) Debug (lldb)",
            "type": "cppdbg", // is this lldb?
            "request": "launch",

            // Run python as the main process
            "program": "/home/victor/miniforge3/envs/robo_dev_py312/bin/python3",
            "args": [
                "${workspaceFolder}/build/roborun.py",
                "1apq_test",
                "${workspaceFolder}/build/data-raw/1APQ.prmtop",
                "${workspaceFolder}/build/data-raw/1APQ_min.inpcrd",
                "6000",
                "10",
                "10",
                "1",
                "tdnr",
                "\"[[]]\"",
            ],

            // Required: stop when .so is loaded, so breakpoints become active
            "stopOnSharedLibraryLoad": true,

            // Ensure debug symbols are used
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/build",
                "ROBOSAMPLE_DEBUG": "1"
            },

            "console": "integratedTerminal",
            "justMyCode": false,

            // Working directory
            "cwd": "${workspaceFolder}",

            // If Python loads the .so dynamically, lldb will catch it
            "initCommands": [
                "settings set target.inline-breakpoint-strategy always",
                "settings set target.process.stop-on-sharedlibrary-load true"
            ]
        }
    ]
}
