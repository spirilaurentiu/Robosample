{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python",
            },
            "args": [
                "2ala.test",
                "${workspaceFolder}/examples/2ala.prmtop",
                "${workspaceFolder}/examples/2ala.inpcrd",
                "6000",
                "0",
                "1",
                "1",
            ],
            "cwd": "${workspaceFolder}",
        },

        {
            "name": "Python C++ Debug with CodeLLDB",
            "type": "lldb",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/python/robosample/roborun.py",
                "2ala.test",
                "${workspaceFolder}/examples/2ala.prmtop",
                "${workspaceFolder}/examples/2ala.inpcrd",
                "6000",
                "0",
                "1",
                "1"
            ],

            "cwd": "${workspaceFolder}",

            "env": {
                // "LD_PRELOAD": "/usr/lib/llvm-18/lib/clang/18/lib/linux/libclang_rt.asan-x86_64.so",
                "LD_LIBRARY_PATH": "${workspaceFolder}/build",
                // "ASAN_OPTIONS": "protect_shadow_gap=0:detect_leaks=0:abort_on_error=0:halt_on_error=1"
            }
        }

    ]
}
