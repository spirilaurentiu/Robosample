{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python",
            },
            "args": [
                "1APQ.test",
                "${workspaceFolder}/examples/1APQ.prmtop",
                "${workspaceFolder}/examples/1APQ.rst7",
                "6000",
                "0",
                "10",
                "1",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python: roborun.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/robosample/roborun.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python",
            },
            "args": [
                "1APQ.test",
                "${workspaceFolder}/examples/1APQ.prmtop",
                "${workspaceFolder}/examples/1APQ.rst7",
                "6000",
                "0",
                "10",
                "1",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python C++ Debug with CodeLLDB",
            "type": "lldb",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python",
            },
            "args": [
                "${workspaceFolder}/python/robosample/roborun.py",
                "1APQ.test",
                "${workspaceFolder}/examples/1APQ.prmtop",
                "${workspaceFolder}/examples/1APQ.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}",
            // "env": {
            //     "LD_LIBRARY_PATH": "${workspaceFolder}/build",
            //     // "ASAN_OPTIONS": "protect_shadow_gap=0:detect_leaks=0:abort_on_error=0:halt_on_error=1"
            // }
        }

    ]
}
