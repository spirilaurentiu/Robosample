{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: run.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/robosample/run.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample"
            },
            "args": [
                "host",
                "${workspaceFolder}/examples/host.prmtop",
                "${workspaceFolder}/examples/host.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "C++ (gdb) run.py",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/python/robosample/run.py",
                "host",
                "${workspaceFolder}/examples/host.prmtop",
                "${workspaceFolder}/examples/host.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/python/robosample"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "set auto-load safe-path /", "description": "let conda libstdc++ pretty-printers load" },
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set index-cache enabled on", "description": "cache indexes across runs" }
            ]
        }
    ]
}