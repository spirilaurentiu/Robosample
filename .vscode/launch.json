{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: run.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/robosample/run.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample"
            },
            "args": [
                "host-guest",
                "${workspaceFolder}/examples/host-guest.prmtop",
                "${workspaceFolder}/examples/host-guest.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "C++ (gdb) run.py",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/python/robosample/run.py",
                "host-guest",
                "${workspaceFolder}/examples/host-guest.prmtop",
                "${workspaceFolder}/examples/host-guest.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/python/robosample"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                { "text": "set auto-load safe-path /", "description": "let conda libstdc++ pretty-printers load" },
                { "text": "set index-cache enabled on", "description": "cache indexes across runs" },
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "python import sys, os, glob; env = os.path.dirname(os.path.dirname(r'${command:python.interpreterPath}')); sys.path[:0] = glob.glob(os.path.join(env, 'share', 'gcc-*', 'python')); from libstdcxx.v6.printers import register_libstdcxx_printers; register_libstdcxx_printers(None)", "description": "register STL pretty-printers; env derived from selected interpreter" }
            ]
        }
    ]
}