{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample",
            },
            "args": [
                "ala-dipeptide",
                "${workspaceFolder}/examples/ala-dipeptide.prmtop",
                "${workspaceFolder}/examples/ala-dipeptide.rst7",
                "6000",
                "0",
                "10",
                "1",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python: roborun.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/robosample/roborun.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample",
            },
            "args": [
                "ala-dipeptide",
                "${workspaceFolder}/examples/ala-dipeptide.prmtop",
                "${workspaceFolder}/examples/ala-dipeptide.rst7",
                "6000",
                "0",
                "10",
                "1",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Python C++ Debug with CodeLLDB",
            "type": "lldb",
            "request": "launch",
            "program": "${command:python.interpreterPath}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python/robosample",
            },
            "args": [
                "${workspaceFolder}/python/robosample/roborun.py",
                "ala-dipeptide",
                "${workspaceFolder}/examples/ala-dipeptide.prmtop",
                "${workspaceFolder}/examples/ala-dipeptide.rst7",
                "6000",
                "0",
                "10",
                "1"
            ],
            "cwd": "${workspaceFolder}",
        }
    ]
}
