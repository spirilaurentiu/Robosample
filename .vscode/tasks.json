{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run tests and coverage",
            "type": "shell",
            "command": "nox --envdir ${CONDA_PREFIX} -s tests --no-venv",
            "group": "test"
        },
        {
            "label": "Run full PGO/BOLT pipeline",
            "type": "shell",
            "command": "nox --envdir ${CONDA_PREFIX} -s build_optimized --no-venv",
            "group": "test"
        }
    ]
}
